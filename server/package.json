{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --no-warnings=ExperimentalWarning src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --no-warnings=ExperimentalWarning dist/index.js",
    "db": "tsx --no-warnings=ExperimentalWarning src/ensure-db.ts",
    "db:prod": "node --no-warnings=ExperimentalWarning dist/ensure-db.js",
    "seed": "tsx --no-warnings=ExperimentalWarning src/seed.ts",
    "seed:prod": "node --no-warnings=ExperimentalWarning dist/seed.js",
    "backup": "tsx --no-warnings=ExperimentalWarning src/backup.ts",
    "backup:prod": "node --no-warnings=ExperimentalWarning dist/backup.js",
    "audit": "tsx --no-warnings=ExperimentalWarning src/audit.ts",
    "audit:prod": "node --no-warnings=ExperimentalWarning dist/audit.js",
    "download-list": "tsx --no-warnings=ExperimentalWarning scripts/download-list.ts",
    "import-covers": "tsx --no-warnings=ExperimentalWarning scripts/import-covers.ts",
    "test": "tsx --no-warnings=ExperimentalWarning --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
